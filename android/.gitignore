# Host-mounted volumes for the Docker-based gradle build — never commit.
.gradle/
.gradle-cache/
.gradle-bin/
.android-home/
# NOTE: debug.keystore is intentionally tracked (see app/build.gradle.kts).
# Debug-keystore credentials are public (Android Studio convention) and
# pinning the cert lets sideloaded rebuilds install in place.

# Android Gradle Plugin build output (includes the .apk; rebuild on demand).
app/build/
build/
*.apk
*.aab
*.aar

# IDE noise.
.idea/
*.iml
.cxx/
captures/

# MSYS path-mangling residue from earlier docker runs on Git Bash.
*\;C/
*\;C
local.properties
